# --- Postgres ---
POSTGRES_USER=shortstack
POSTGRES_PASSWORD=shortstack
POSTGRES_DB=shortstack
DATABASE_URL=postgresql+psycopg://shortstack:shortstack@localhost:5432/shortstack

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=shortstack
S3_SECRET_KEY=shortstack-dev-secret
S3_BUCKET=shortstack
S3_REGION=us-east-1

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-4-6
UTILITY_MODEL=claude-haiku-4-5

# --- TTS (ElevenLabs primary, OpenAI fallback) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
OPENAI_API_KEY=

# --- Image gen ---
REPLICATE_API_TOKEN=
PEXELS_API_KEY=
FLUX_MODEL=black-forest-labs/flux-schnell

# --- Trends ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=shortstack/0.1
YOUTUBE_API_KEY=

# --- Publish (YouTube Shorts) ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- Render service ---
RENDER_SERVICE_URL=http://localhost:8787

# --- Cost caps (cents per video) ---
COST_SOFT_CAP_CENTS=75
COST_HARD_CAP_CENTS=100
